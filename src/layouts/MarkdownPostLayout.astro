---
import BaseLayout from './BaseLayout.astro'
const { frontmatter } = Astro.props
const pageTitle = frontmatter.title
---

<BaseLayout>
  <div class='bg-slate-400 p-4 rounded'>
    <h1 class='text-center text-5xl font-black underline underline-offset-4'>{pageTitle}</h1>
    <div class='pb-4 flex justify-between items-center font-semibold border-b-4 border-gray-800'>
      <p>Published on : {frontmatter.pubDate.toString().slice(0, 10)}</p>
      <p>
        Written by <span class='text-blue-600 font-bold text-lg underline'
          >{frontmatter.author}</span
        >
      </p>
    </div>
    <img
      class='w-4/5 mx-auto rounded-lg my-8 max-h-96'
      src={frontmatter.image.url}
      alt={frontmatter.image.alt}
      width='100%'
    />
    <div class='flex flex-wrap mb-4 pb-4 border-b-4 border-gray-800'>
      {
        frontmatter.tags.map((tag: any) => (
          <p class='m-1 border p-1 px-4 font-semibold text-lg bg-cyan-100 rounded underline '>
            <a class='text-blue-700' href={`/tags/${tag}`}>
              {tag}
            </a>
          </p>
        ))
      }
    </div>
    <slot />
  </div>
</BaseLayout>
